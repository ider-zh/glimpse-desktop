<Window x:Class="Glimpse.UI.CodeBuddyLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="CodeBuddy 登录" Width="1100" Height="860" MinWidth="720" MinHeight="640"
        WindowStartupLocation="CenterOwner" Background="#F5F8FA">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="登录本机 CodeBuddy" FontSize="21" FontWeight="SemiBold"/>
      <TextBlock Text="在下方终端选择登录方式，再通过浏览器完成验证。账号由 CodeBuddy 管理；Glimpse 不保存终端内容。" TextWrapping="Wrap" Foreground="#617387" Margin="0,6,0,12"/>
    </StackPanel>
    <WrapPanel Grid.Row="1">
      <Button x:Name="StartButton" Content="启动登录终端" Click="StartLogin" Background="#19766F" Foreground="White" IsEnabled="False"/>
      <Button x:Name="StopButton" Content="结束登录进程" Click="StopLogin" IsEnabled="False"/>
      <Button Content="关闭" Click="CloseWindow"/>
    </WrapPanel>
    <Grid Grid.Row="2" Background="#152333">
      <wv:WebView2 x:Name="EmbeddedTerminal" DefaultBackgroundColor="#152333" AutomationProperties.Name="CodeBuddy 交互终端"/>
      <TextBlock x:Name="TerminalLoading" Text="正在初始化交互终端…" Foreground="#E4EDF5" Margin="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
      <TextBox x:Name="Terminal" IsReadOnly="True" IsReadOnlyCaretVisible="True" Visibility="Collapsed"
             FontFamily="Cascadia Mono, Consolas" FontSize="12" Background="#152333" Foreground="#E4EDF5"
             BorderThickness="0" Padding="12" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
             HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="CodeBuddy 登录终端输出"
             Text="点击“启动登录终端”后显示本机 CLI 的交互界面。"/>
    </Grid>
    <StackPanel Grid.Row="3" Margin="0,10,0,0">
      <DockPanel x:Name="TerminalToolbar">
        <WrapPanel DockPanel.Dock="Right">
          <Button Content="A−" Tag="-1" Click="ChangeFont" ToolTip="缩小终端字号"/>
          <Button Content="A+" Tag="1" Click="ChangeFont" ToolTip="放大终端字号"/>
          <Button x:Name="CopySelectionButton" Content="复制选中" Click="CopySelection" IsEnabled="False"/>
          <Button x:Name="PasteButton" Content="粘贴" Click="PasteTerminal" IsEnabled="False"/>
        </WrapPanel>
        <TextBlock Text="直接在终端输入 · ↑↓ 选择 · Enter 确认 · Ctrl+Shift+C/V 复制与粘贴" Foreground="#617387" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,7"/>
      </DockPanel>
      <StackPanel x:Name="FallbackControls" Visibility="Collapsed">
        <TextBlock Text="交互终端不可用，已切换为基本文本模式。安装 Microsoft Edge WebView2 Runtime 后可获得完整终端体验。" Foreground="#9B6709" TextWrapping="Wrap" Margin="0,0,0,6"/>
        <Button Content="获取 WebView2 Runtime" Click="InstallRuntime" HorizontalAlignment="Left"/>
        <WrapPanel x:Name="KeyButtons" IsEnabled="False">
        <Button Content="↑ 上一项" Tag="up" Click="SendKey"/>
        <Button Content="↓ 下一项" Tag="down" Click="SendKey"/>
        <Button Content="Tab" Tag="tab" Click="SendKey"/>
        <Button Content="Enter 确认" Tag="enter" Click="SendKey"/>
        <Button Content="Esc 返回" Tag="escape" Click="SendKey"/>
        </WrapPanel>
      <DockPanel x:Name="InputPanel" IsEnabled="False">
        <Button DockPanel.Dock="Right" Content="发送并回车" Click="SendText" Margin="8,0,0,0"/>
        <TextBox x:Name="Input" MaxLength="4000" KeyDown="InputKeyDown" AutomationProperties.Name="登录终端输入"/>
        </DockPanel>
      </StackPanel>
      <TextBlock Text="输入内容只交给本机 CLI。请勿在此输入密码；在 CodeBuddy 官方浏览器页面中完成验证。" Foreground="#617387" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,8"/>
    </StackPanel>
    <StackPanel Grid.Row="4">
      <TextBlock Text="终端中的验证链接" FontWeight="SemiBold"/>
      <ComboBox x:Name="Links" Margin="0,5,0,6" Padding="6" SelectionChanged="LinkSelected" AutomationProperties.Name="可用验证链接"/>
      <TextBox x:Name="SelectedLink" IsReadOnly="True" IsReadOnlyCaretVisible="True" TextWrapping="Wrap" MaxHeight="70" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="完整验证链接"/>
      <WrapPanel Margin="0,7,0,0">
        <Button x:Name="OpenLinkButton" Content="在浏览器打开所选链接" Click="OpenLink" IsEnabled="False"/>
        <Button x:Name="CopyLinkButton" Content="复制所选链接" Click="CopyLink" IsEnabled="False"/>
      </WrapPanel>
    </StackPanel>
    <TextBlock x:Name="LoginStatus" Grid.Row="5" Text="尚未启动。登录完成后关闭此窗口，重新预览并生成以验证引擎。" TextWrapping="Wrap" Foreground="#617387" Margin="0,4,0,0" AutomationProperties.LiveSetting="Polite"/>
    <TextBlock Grid.Row="6" Text="关闭此窗口会结束其登录进程；已由 CodeBuddy 保存的登录状态会保留。" FontSize="11" Foreground="#617387" TextWrapping="Wrap" Margin="0,7,0,0"/>
  </Grid>
</Window>
