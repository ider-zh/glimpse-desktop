<Window x:Class="Glimpse.UI.DockedToolbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Glimpse 观察工具栏" Width="320" Height="490" MinWidth="0" MinHeight="0"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13" Foreground="#203044"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <Style x:Key="ToolbarFocus" TargetType="Control">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Control">
        <Rectangle Stroke="#19766F" StrokeThickness="2" StrokeDashArray="2,2" Margin="2"/>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Padding" Value="9,8"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource ToolbarFocus}"/>
    </Style>
  </Window.Resources>
  <Border Margin="5" Padding="14" Background="#FAFCFD" BorderBrush="#CADBD9" BorderThickness="1" CornerRadius="10">
    <Border.Effect><DropShadowEffect Color="#213E3A" Opacity="0.16" BlurRadius="9" ShadowDepth="2"/></Border.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <DockPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
          <Ellipse x:Name="StateDot" Width="7" Height="7" Fill="#8492A6" Margin="0,0,6,0"/>
          <TextBlock x:Name="StateLabel" Text="已停止" FontSize="11" Foreground="#617387"/>
        </StackPanel>
        <TextBlock Text="GLIMPSE" Foreground="#19766F" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </DockPanel>
      <StackPanel Grid.Row="1" Margin="0,8,0,12">
        <TextBlock x:Name="CaptureStatus" Text="等待开始观察" Foreground="#617387" FontSize="12" TextTrimming="CharacterEllipsis" LineHeight="18" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" AutomationProperties.LiveSetting="Polite"/>
        <TextBlock x:Name="Counts" Text="已记录 0 块 · 0 字" FontSize="11" Foreground="#617387" Margin="0,3,0,0"/>
      </StackPanel>
      <Grid Grid.Row="2">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="7"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Button x:Name="RecordsButton" Content="记录区" Click="OpenRecords" ToolTip="查看已保存的会话、累计文本和生成结果"/>
        <Button x:Name="ObserveButton" Grid.Column="2" Content="开始观察" Click="ToggleObservation" ToolTip="开始或停止当前区域的本地观察"/>
        <Button x:Name="ReselectButton" Grid.Row="2" Content="重新框选" Click="Reselect" ToolTip="停止当前观察，然后重新选择屏幕区域"/>
        <Button x:Name="CloseLensButton" Grid.Row="2" Grid.Column="2" Content="关闭观察框" Click="CloseLens" Foreground="#8F4C40" ToolTip="立即停止观察并关闭观察框；已记录内容保留"/>
      </Grid>
      <Border Grid.Row="3" Height="1" Background="#DCE5EA" Margin="0,14,0,12"/>
      <DockPanel Grid.Row="4" Margin="0,0,0,8">
        <TextBlock Text="阅读助手" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <ComboBox x:Name="PromptTask" HorizontalAlignment="Right" MinWidth="132" Padding="6,4" SelectedIndex="2" SelectionChanged="TaskChanged" AutomationProperties.Name="助手任务">
          <ComboBoxItem Content="帮我评论" Tag="comment"/>
          <ComboBoxItem Content="帮我回复" Tag="reply"/>
          <ComboBoxItem Content="总结" Tag="summary"/>
          <ComboBoxItem Content="给我建议" Tag="analysis"/>
          <ComboBoxItem Content="自定义提问" Tag="custom"/>
        </ComboBox>
      </DockPanel>
      <TextBlock x:Name="PromptLabel" Grid.Row="5" Text="补充要求（可选）" FontSize="12" Foreground="#617387" Margin="0,0,0,5"/>
      <TextBox x:Name="PromptInput" Grid.Row="6" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="8" MaxLength="4000" BorderBrush="#D8E1E8" Background="White" MinHeight="52" KeyDown="PromptKeyDown" TextChanged="PromptEdited" AutomationProperties.Name="给阅读助手的补充要求"/>
      <StackPanel Grid.Row="7" Margin="0,7,0,8">
        <TextBlock x:Name="PromptError" Foreground="#9B6709" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed" AutomationProperties.LiveSetting="Assertive"/>
        <TextBlock x:Name="PromptHint" Text="先记录一些文字，再预览上下文。" Foreground="#617387" FontSize="11" TextWrapping="Wrap"/>
      </StackPanel>
      <Button x:Name="PreviewButton" Grid.Row="8" Content="预览并生成…" Click="OpenPromptPreview" Background="#19766F" Foreground="White" IsEnabled="False" ToolTip="打开阅读助手并预览上下文；检查后由你点击生成。Ctrl+Enter"/>
    </Grid>
  </Border>
</Window>
