<Window x:Class="Glimpse.UI.DockedToolbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Glimpse 观察工具栏" Width="360" Height="760" MinWidth="0" MinHeight="0"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13" Foreground="#203044"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <Style x:Key="ToolbarFocus" TargetType="Control">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Control">
        <Rectangle Stroke="#19766F" StrokeThickness="2" StrokeDashArray="2,2" Margin="2"/>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Padding" Value="9,8"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource ToolbarFocus}"/>
    </Style>
  </Window.Resources>
  <Border Margin="5" Padding="14" Background="#FAFCFD" BorderBrush="#CADBD9" BorderThickness="1" CornerRadius="10">
    <Border.Effect><DropShadowEffect Color="#213E3A" Opacity="0.16" BlurRadius="9" ShadowDepth="2"/></Border.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <DockPanel>
        <Button x:Name="SettingsButton" DockPanel.Dock="Right" Content="设置" Click="OpenSettings" Padding="7,3" MinHeight="25" FontSize="11" Margin="9,0,0,0" ToolTip="配置引擎、模型和登录"/>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
          <Ellipse x:Name="StateDot" Width="7" Height="7" Fill="#8492A6" Margin="0,0,6,0"/>
          <TextBlock x:Name="StateLabel" Text="已停止" FontSize="11" Foreground="#617387"/>
        </StackPanel>
        <TextBlock Text="GLIMPSE" Foreground="#19766F" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </DockPanel>
      <StackPanel Grid.Row="1" Margin="0,8,0,12">
        <TextBlock x:Name="CaptureStatus" Text="等待开始观察" Foreground="#617387" FontSize="12" TextTrimming="CharacterEllipsis" LineHeight="18" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" AutomationProperties.LiveSetting="Polite"/>
        <TextBlock x:Name="Counts" Text="已记录 0 块 · 0 字" FontSize="11" Foreground="#617387" Margin="0,3,0,0"/>
      </StackPanel>
      <Grid Grid.Row="2">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="7"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Button x:Name="RecordsButton" Content="记录区" Click="OpenRecords" ToolTip="查看已保存的会话、累计文本和生成结果"/>
        <Button x:Name="ObserveButton" Grid.Column="2" Content="开始观察" Click="ToggleObservation" ToolTip="开始或停止当前区域的本地观察"/>
        <Button x:Name="ReselectButton" Grid.Row="2" Content="重新框选" Click="Reselect" ToolTip="停止当前观察，然后重新选择屏幕区域"/>
        <Button x:Name="CloseLensButton" Grid.Row="2" Grid.Column="2" Content="关闭观察框" Click="CloseLens" Foreground="#8F4C40" ToolTip="立即停止观察并关闭观察框；已记录内容保留"/>
      </Grid>
      <Border Grid.Row="3" Height="1" Background="#DCE5EA" Margin="0,14,0,12"/>
      <Grid Grid.Row="4" Margin="0,0,0,9">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="AgentStatus" Text="先记录一些文字，再点击任务或发送问题。" Foreground="#617387" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
        <Button x:Name="CancelButton" Grid.Column="1" Content="取消生成" Click="CancelRequest" Margin="7,0,0,0" Visibility="Collapsed"/>
      </Grid>
      <ScrollViewer x:Name="AgentScroll" Grid.Row="5" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,3,0">
        <StackPanel>
          <TextBlock Text="阅读助手" FontWeight="SemiBold" Margin="0,0,0,4"/>
          <TextBlock Text="点击任务直接生成，可先填写补充要求。" Foreground="#617387" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,9"/>
          <UniformGrid Columns="2" Rows="2" Margin="0,0,-7,7">
            <Button x:Name="CommentButton" Content="帮我评论" Tag="comment" Click="QuickGenerate" Margin="0,0,7,7" ToolTip="根据当前阅读内容生成评论"/>
            <Button x:Name="ReplyButton" Content="帮我回复" Tag="reply" Click="QuickGenerate" Margin="0,0,7,7" ToolTip="根据当前阅读内容生成回复"/>
            <Button x:Name="SummaryButton" Content="总结" Tag="summary" Click="QuickGenerate" Margin="0,0,7,7" ToolTip="总结当前阅读内容"/>
            <Button x:Name="AdviceButton" Content="给我建议" Tag="analysis" Click="QuickGenerate" Margin="0,0,7,7" ToolTip="分析当前阅读内容并给出建议"/>
          </UniformGrid>
          <TextBlock Text="提问或补充要求" FontSize="12" Foreground="#617387" Margin="0,0,0,5"/>
          <TextBox x:Name="PromptInput" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="8" MaxLength="4000" BorderBrush="#D8E1E8" Background="White" Height="76" KeyDown="PromptKeyDown" TextChanged="PromptEdited" AutomationProperties.Name="给阅读助手的问题或补充要求"/>
          <Button x:Name="SendButton" Content="发送问题" Click="SendPrompt" Background="#19766F" Foreground="White" ToolTip="发送自定义问题。Ctrl+Enter" Margin="0,8,0,12"/>
          <TextBlock x:Name="PreviousResultNotice" Text="上次结果" FontWeight="SemiBold" Foreground="#617387" FontSize="12" Margin="0,0,0,5" Visibility="Collapsed"/>
          <TextBlock x:Name="ResultSummary" Foreground="#617387" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,5"/>
          <TextBlock x:Name="CopyStatus" Foreground="#19766F" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,5" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"/>
          <TextBlock x:Name="ResultWarnings" Foreground="#9B6709" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,7"/>
          <Expander x:Name="PreviewExpander" Header="本次发送内容" Visibility="Collapsed" IsExpanded="False" Margin="0,0,0,9">
            <StackPanel Margin="0,7,0,0">
              <TextBlock x:Name="PreviewSummary" Foreground="#617387" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"/>
              <TextBox x:Name="PreviewText" IsReadOnly="True" IsReadOnlyCaretVisible="True" Height="180" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" FontSize="11"/>
            </StackPanel>
          </Expander>
          <ItemsControl x:Name="ResultCards">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="#DCE5EA" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,0,0,9" Background="White">
                  <StackPanel>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Tone}" FontSize="11" Foreground="#617387" TextWrapping="Wrap" Margin="0,3,0,0"/>
                    <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" IsReadOnlyCaretVisible="True" TextWrapping="Wrap" FontSize="14" MaxHeight="280" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent" Padding="0,7,0,8"/>
                    <Button Content="复制文字" Tag="{Binding Text}" Click="CopyCard" HorizontalAlignment="Left" MinHeight="30" Padding="9,5"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Border x:Name="FallbackPanel" Visibility="Collapsed" BorderBrush="#E0C98D" BorderThickness="1" CornerRadius="7" Padding="10" Background="#FFFBF0" Margin="0,0,0,9">
            <StackPanel>
              <TextBlock Text="原始回答 · 格式未通过校验" Foreground="#9B6709" FontWeight="SemiBold" TextWrapping="Wrap"/>
              <TextBox x:Name="FallbackText" IsReadOnly="True" IsReadOnlyCaretVisible="True" FontSize="14" MaxHeight="300" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Padding="0,8"/>
              <Button Content="复制原始文字" Click="CopyFallback" HorizontalAlignment="Left" MinHeight="30" Padding="9,5"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Border>
</Window>
