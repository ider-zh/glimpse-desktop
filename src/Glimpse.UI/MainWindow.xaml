<Window x:Class="Glimpse.UI.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Glimpse · Session Reader" Width="530" Height="850" MinWidth="470" MinHeight="650" Background="#F5F8FA">
  <Grid Margin="22">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,18"><StackPanel><TextBlock Text="glimpse" FontSize="32" FontWeight="SemiBold" Foreground="#19766F"/><TextBlock Text="留住你读过的上下文" Foreground="#617387" Margin="1,2,0,0"/></StackPanel><Border Background="#E1EEEB" CornerRadius="4" Padding="8,4" HorizontalAlignment="Right" VerticalAlignment="Top"><TextBlock Text="LOCAL · V0.1 PREVIEW" FontSize="10" Foreground="#19766F"/></Border></Grid>
    <StackPanel Grid.Row="1">
      <TextBlock Text="已保存的会话" FontWeight="SemiBold" Margin="0,0,0,7"/>
      <ComboBox x:Name="Sessions" DisplayMemberPath="Title" Padding="8" Margin="0,0,0,9"/>
      <WrapPanel><Button Content="新建会话" Click="NewSession"/><Button Content="打开 / 恢复" Click="OpenSession"/><Button Content="删除" Click="DeleteSession"/><Button Content="导出文本" Click="ExportSession"/></WrapPanel>
    </StackPanel>
    <Border Grid.Row="2" Background="White" BorderBrush="#DCE5EA" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,8,0,12">
      <StackPanel>
        <TextBlock x:Name="SessionTitle" Text="选择区域，开始一段阅读" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
        <TextBlock x:Name="Geometry" Text="只观察你选中的屏幕区域。原始截图不保存。" Margin="0,6,0,12" Foreground="#617387" TextWrapping="Wrap"/>
        <WrapPanel><Button Content="选择区域" Click="SelectRegion"/><Button x:Name="ObserveButton" Content="开始观察" Click="ToggleObserve" Background="#19766F" Foreground="White"/><Button Content="手动刷新" Click="Refresh"/><Button Content="关闭取景框" Click="CloseLens"/></WrapPanel>
        <StackPanel Orientation="Horizontal" Margin="0,4,0,0"><Ellipse x:Name="StateDot" Width="8" Height="8" Fill="#8492A6" Margin="0,0,7,0"/><TextBlock x:Name="Status" Text="正在连接本地 Worker…" TextWrapping="Wrap" MaxWidth="390"/></StackPanel>
        <TextBlock x:Name="Metrics" Margin="0,7,0,0" Foreground="#617387" FontSize="11" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0"><TextBlock Text="OCR 语言" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#617387"/><ComboBox x:Name="OcrLanguages" MinWidth="150" SelectionChanged="LanguageSelected" Padding="5,3"/></StackPanel>
      </StackPanel>
    </Border>
    <TextBlock Grid.Row="3" x:Name="Counts" Text="最近快照 0/9 · 累计 0 块 · 0 字符" Foreground="#617387" Margin="0,0,0,10"/>
    <TabControl Grid.Row="4" BorderBrush="#DCE5EA" Background="White">
      <TabItem Header="累计文本"><TextBox x:Name="Document" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" FontSize="14" Padding="14" Text="尚无记录。选择区域后，点击开始观察；停留 1 秒后识别。"/></TabItem>
      <TabItem Header="快照 / 来源"><Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="130"/><RowDefinition Height="*"/></Grid.RowDefinitions><ListBox x:Name="Snapshots" DisplayMemberPath="Label" SelectionChanged="SnapshotSelected"/><TextBox Grid.Row="1" x:Name="SnapshotDetail" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0"/></Grid></TabItem>
      <TabItem Header="可能遗漏"><TextBox x:Name="Gaps" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" Padding="14" Text="暂无警告。没有警告也不代表内容完整。"/></TabItem>
      <TabItem Header="使用说明"><ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock Margin="14" TextWrapping="Wrap" LineHeight="24">
        <Run FontWeight="SemiBold">本地 Session Reader</Run><LineBreak/><LineBreak/>
        <Run>1. 新建会话或恢复已有会话。</Run><LineBreak/><Run>2. 拖动选择一个区域，点击开始观察。</Run><LineBreak/><Run>3. 通过镂空区域操作原应用，停留 1 秒后识别。</Run><LineBreak/><Run>4. 拖动取景框上边框移动，拖动边角缩放。</Run><LineBreak/><Run>5. 随时暂停；关闭取景框不会删除会话。</Run><LineBreak/><LineBreak/>
        <Run>绿色表示稳定帧已处理并保存，不代表识别准确或内容完整。快速滚动经过的内容无法补回。</Run><LineBreak/><LineBreak/>
        <Run>截图只在内存中存在。OCR 文本保存在本机 SQLite，可导出或删除。不调用云服务，也不操作其他应用。</Run><LineBreak/><LineBreak/>
        <Run>OCR 使用 Windows 已安装的语言。缺少识别语言时，按 Windows 设置提示安装；可用 GLIMPSE_OCR_LANGUAGE 指定语言。</Run><LineBreak/><LineBreak/>
        <Run>Agent 接入将在 Session Reader 的硬件验收通过后提供。</Run>
      </TextBlock></ScrollViewer></TabItem>
    </TabControl>
    <TextBlock Grid.Row="5" Text="本机存储 · 无后台上传 · 关闭即停止观察" FontSize="10" Foreground="#78899A" Margin="0,14,0,0" HorizontalAlignment="Center"/>
  </Grid>
</Window>
