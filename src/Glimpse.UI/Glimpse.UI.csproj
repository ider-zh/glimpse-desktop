<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>../Glimpse.Worker/app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <ProjectReference Include="../Glimpse.Contracts/Glimpse.Contracts.csproj" />
    <ProjectReference Include="../Glimpse.Core/Glimpse.Core.csproj" />
    <ProjectReference Include="../Glimpse.Worker/Glimpse.Worker.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="TerminalAssets/**/*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CopyWorker" AfterTargets="Build">
    <PropertyGroup><WorkerOutput>../Glimpse.Worker/bin/$(Configuration)/$(TargetFramework)/$(RuntimeIdentifier)</WorkerOutput></PropertyGroup>
    <ItemGroup><WorkerFiles Include="$(WorkerOutput)/**/*" Exclude="$(WorkerOutput)/**/*.pdb;$(WorkerOutput)/win-*/**/*" /></ItemGroup>
    <Copy SourceFiles="@(WorkerFiles)" DestinationFiles="@(WorkerFiles->'$(OutDir)Worker/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
